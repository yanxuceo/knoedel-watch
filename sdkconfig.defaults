# M5Stack StopWatch (C152): ESP32-S3R8, 16MB flash, 8MB octal PSRAM
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# 3 MB for the program, the rest for the content pack (decks, fonts, audio)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
# The card stage draws with large local outlines (vec::Path): 8 KB overflowed
# on the mountain cards, where a prop draws Knödel inside a landscape.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20480
# Log output over the USB-C port (native USB Serial/JTAG)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# The character is drawn in software every frame
CONFIG_COMPILER_OPTIMIZATION_PERF=y
